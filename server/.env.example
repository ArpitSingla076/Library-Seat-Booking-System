PORT=5000
# Local MongoDB on your computer (default). For MongoDB Atlas (cloud) replace with your connection string:
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/library_booking?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/library_booking
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=1h
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# ---- Email (booking confirmations, reminders, fine alerts) ----
# Leave SMTP_HOST empty and emails are only printed in the server log.
# Gmail example (needs 2-Step Verification ON and an "App password", NOT your normal password):
#   SMTP_HOST=smtp.gmail.com   SMTP_PORT=587   SMTP_USER=yourname@gmail.com   SMTP_PASS=the16letterapppassword
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=BookMySeat <yourname@gmail.com>


# Fine payments. Leave these empty for the built-in DEMO checkout (no real money).
# For real payments create a Razorpay account (test keys are free) and paste the keys here:
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
